
@{ 

    @using System.Text.Json

    Layout = null;
    ViewData["Title"] = "Dossiê do Agente";

    @model CriarFichaModel


}

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/ficha.css">
    <link rel="icon" type="image/x-icon" href="~/favicon.ico">
</head>
<body>
    <div class="scanlines"></div>
    <div class="sheet-container">

        <!-- DOSSIÊ DA SCARE (Oculto por padrão) -->
        <!-- BOTÕES DE NAVEGAÇÃO / AÇÃO -->
        <div class="top-nav">
            <button type="button" class="btn-top" style="margin-right: auto;" onclick="window.location.href='@Url.Action("Listagem", "Agentes")'">Voltar</button>
            <button class="btn-top" onclick="toggleInfo()">Info</button>
            <button class="btn-top" onclick="salvarFicha()">Salvar</button>
            <!--<button class="btn-top" onclick="baixarPDF()" >Baixar PDF</button>-->
            <button class="btn-top btn-logout" onclick="deletarPersonagem()">Apagar</button>
        </div>

        <div id="dossier-section" class="dossier-only" style="display: none; margin-bottom: 20px;">
            <div class="cyber-panel-wrapper" style="height: fit-content">
                <div class="panel-title" style="color: #ff3366; text-shadow: 0 0 5px #ff3366;">ARQUIVO CONFIDENCIAL - S.C.A.R.E. (ACESSO RESTRITO)</div>
                <div class="cyber-panel-bg"><div class="inner-line"></div></div>
                <div class="cyber-panel-content">
                    <div style="display: flex; gap: 20px; flex-wrap: wrap;">

                        <!-- Coluna da Foto (Vinda do Banco de Dados) -->
                        <div style="flex: 0 0 220px; display: flex; flex-direction: column; gap: 10px;">
                            <div class="dossier-photo-container" style="min-height: 250px;">
                                <!-- Integração Razor: Renderiza a imagem do MySQL, se existir, senão usa um placeholder -->
                                <img src="@(Model.Image_Data != null && Model.Image_Data.Length > 0 ? $"data:image/jpeg;base64,{Convert.ToBase64String(Model.Image_Data)}"
                                            : "/img/Gamma_Future_Simbolo.png")" alt="@Model.Nome">
                            </div>
                            <div style="text-align: center; color: var(--neon-blue-dim); font-size: 12px; font-weight: bold; letter-spacing: 2px;">
                                ID VISUAL REGISTRADO
                                <input type="file" name="Imagem" id="image_input" onchange="imgAction()" accept="image/*" class="input-line" style="font-family: var(--font-main);">
                            </div>
                        </div>

                        <!-- Coluna de Informações e Relatórios -->
                        <div style="flex: 1; display: flex; flex-direction: column; gap: 15px;">
                            <div class="header-row">
                                <div class="header-field" style="flex: 2;">
                                    <span class="label">NOME DO AGENTE</span>
                                    <input type="text" class="input-line" id="dossier-nome" placeholder="Sincronizado da ficha..." readonly>
                                </div>
                                <div class="header-field" style="flex: 1;">
                                    <span class="label">PATENTE</span>
                                    <input type="text" class="input-line" id="dossier-patente" placeholder="Sincronizado da ficha..." readonly>
                                </div>
                                <div class="header-field" style="flex: 1;">
                                    <span class="label">IDADE</span>
                                    <input type="number" class="input-line" id="dossier-idade" placeholder="Ex: 28">
                                </div>
                                <div class="header-field" style="flex: 1;">
                                    <span class="label">ORIGEM</span>
                                    <input type="text" class="input-line" id="dossier-origem" placeholder="Sincronizado da ficha..." readonly>
                                </div>
                            </div>

                            <div class="header-row">
                                <div class="header-field" style="flex: 1.5;">
                                    <span class="label">CÓD. AGENTE / CODINOME</span>
                                    <input type="text" class="input-line" id="dossier-codinome" value="@Model.Cod_Agente" placeholder="Ex: S-04 / FANTASMA">
                                </div>
                                <div class="header-field" style="flex: 1.5;">
                                    <span class="label">EQUIPE</span>
                                    <input type="text" class="input-line" id="dossier-equipe" value="@Model.Equipe" placeholder="Ex: Esquadrão Delta">
                                </div>
                                <div class="header-field" style="flex: 1;">
                                    <span class="label">STATUS</span>
                                    <input type="text" class="input-line" id="dossier-status" value="@Model.Status" placeholder="Sincronizado da ficha..." readonly>
                                </div>
                            </div>

                            <div>
                                <span class="label" style="display: block; margin-bottom: 5px;">DESCRIÇÃO DO AGENTE (Físico, Traços Distintos, Psicologia)</span>
                                <textarea class="dossier-textarea" rows="3" placeholder="Insira as características visíveis e comportamentais do agente...">@Model.Descricao</textarea>
                            </div>

                            <div>
                                <span class="label" style="display: block; margin-bottom: 5px;">HISTÓRICO DO AGENTE (Antes e Durante a S.C.A.R.E.)</span>
                                <textarea class="dossier-textarea" rows="4" placeholder="Eventos pregressos, recrutamento, missões notáveis...">@Model.Historia</textarea>
                            </div>

                            <div>
                                <span class="label" style="display: block; margin-bottom: 5px; color: #ff3366;">REGISTRO DE INFRAÇÕES (Conduta e Penalidades)</span>
                                <textarea class="dossier-textarea" rows="3" placeholder="Quebra de protocolo, insubordinação, danos colaterais..." style="border-color: rgba(255, 51, 102, 0.5);">@Model.Infracoes</textarea>
                            </div>

                            <div>
                                <span class="label" style="display: block; margin-bottom: 5px; color: #ffaa00;">ANOTAÇÕES PARA O RESPONSÁVEL / SUPERVISOR</span>
                                <textarea class="dossier-textarea" rows="3" placeholder="Observações, recomendações, mestres, relações..." style="border-color: rgba(255, 170, 0, 0.5);">@Model.Notes</textarea>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="cyber-panel-wrapper sheet-only" style="height: fit-content; width: 100%; padding: 0px;">
            <!-- HEADER -->
            <div class="cyber-panel-wrapper" style="height: fit-content">
                <div class="cyber-panel-bg"><div class="inner-line"></div></div>
                <div class="cyber-panel-content header-grid">
                    <div class="header-row">
                        <div class="header-field" style="flex: 2;">
                            <span class="label">NOME</span><input type="text" value="@Model.Nome" id="ficha-nome" class="input-line">
                        </div>
                        <div class="header-field" style="flex: 0.8;">
                            <span class="label">NÍVEL FÍSICO</span><input type="number" id="nivel-fisico" class="input-line calc-nvl" style="text-align: center;" value="@Model.Nivel_Fis" oninput="updateSkills()">
                        </div>
                        <div class="header-field" style="flex: 0.8;">
                            <span class="label">NÍVEL PSIÔNICO</span><input type="number" id="nivel-psionico" class="input-line calc-nvl" style="text-align: center;" value="@Model.Nivel_Psi" oninput="updateSkills()">
                        </div>
                        <div class="header-field" style="flex: 0.8;">
                            <span class="label">Idade</span><input type="number" value="@Model.Idade" id="ficha-idade" class="input-line">
                        </div>
                    </div>
                    <div class="header-row">
                        <div class="header-field">
                            <span class="label">ORIGEM</span>
                            <div class="select-wrapper">
                                <select class="input-line"  id="ficha-origem">
                                    <option>Adotado pela SCARE</option>
                                    <option>Estudante</option>
                                    <option>CLT</option>
                                    <option>Sem teto</option>
                                </select>
                            </div>
                        </div>

                        <div class="header-field">
                            <span class="label">CLASSE</span>
                            <div class="select-wrapper">
                                <select class="input-line" id="ficha-classe">
                                    <option>Pessoa Normal</option>
                                    <option>Sensitivo</option>
                                    <option>Prodígio</option>
                                </select>
                            </div>
                        </div>
                        <div class="header-field">
                            <span class="label">PATENTE</span>
                            <div class="select-wrapper">
                                <select class="input-line" id="ficha-patente">
                                    <option>Carmesim</option>
                                    <option>Escarlate</option>
                                    <option>Violeta</option>
                                    <option>Índigo</option>
                                    <option>Cobalto</option>
                                    <option>Marinho</option>
                                    <option>Celestial</option>
                                </select>
                            </div>
                        </div>
                        <div class="header-field">
                            <span class="label">STATUS</span>
                            <div class="select-wrapper">
                                <select class="input-line" id="ficha-status">
                                    <option>Ativo</option>
                                    <option>Em Missão</option>
                                    <option>Inativo</option>
                                    <option>Morto</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="cyber-panel-wrapper sheet-only" style="height: fit-content; width: 100%; padding: 0px;">
            <!-- LAYOUT TOP: ESQUERDA (Atributos, Vitais, Combate) vs DIREITA (Perícias) -->
            <div class="layout-top-grid">

                <!-- COLUNA ESQUERDA -->
                <div class="col-flex">

                    <!-- T20 ATTRIBUTES PANEL -->
                    <div class="cyber-panel-wrapper" style="height: fit-content">
                        <div class="panel-title">Atributos Primários</div>
                        <div class="cyber-panel-bg"><div class="inner-line"></div></div>
                        <div class="cyber-panel-content">
                            <div class="attr-t20-container">
                                <div class="attr-box-t20">
                                    <div class="attr-title-wrapper"><div class="attr-title">FOR.</div></div>
                                    <div class="attr-points"><input type="number" class="calc-points" value="@Model.Atributos[0].Pontos" oninput="updateBonus(this)"></div>
                                    <div class="attr-foot"><div class="attr-foot-bubble"><span>Bônus</span><input type="text" class="calc-bonus" id="bonus-FOR" readonly tabindex="-1"></div></div>
                                </div>
                                <div class="attr-box-t20">
                                    <div class="attr-title-wrapper"><div class="attr-title">CON.</div></div>
                                    <div class="attr-points"><input type="number" class="calc-points" value="@Model.Atributos[1].Pontos" oninput="updateBonus(this)"></div>
                                    <div class="attr-foot"><div class="attr-foot-bubble"><span>Bônus</span><input type="text" class="calc-bonus" id="bonus-CON" readonly tabindex="-1"></div></div>
                                </div>
                                <div class="attr-box-t20">
                                    <div class="attr-title-wrapper"><div class="attr-title">DES.</div></div>
                                    <div class="attr-points"><input type="number" class="calc-points" value="@Model.Atributos[2].Pontos" oninput="updateBonus(this)"></div>
                                    <div class="attr-foot"><div class="attr-foot-bubble"><span>Bônus</span><input type="text" class="calc-bonus" id="bonus-DES" readonly tabindex="-1"></div></div>
                                </div>
                                <div class="attr-box-t20">
                                    <div class="attr-title-wrapper"><div class="attr-title">INT.</div></div>
                                    <div class="attr-points"><input type="number" class="calc-points" value="@Model.Atributos[3].Pontos" oninput="updateBonus(this)"></div>
                                    <div class="attr-foot"><div class="attr-foot-bubble"><span>Bônus</span><input type="text" class="calc-bonus" id="bonus-INT" readonly tabindex="-1"></div></div>
                                </div>
                                <div class="attr-box-t20">
                                    <div class="attr-title-wrapper"><div class="attr-title" style="font-size: 13px;">CONH.</div></div>
                                    <div class="attr-points"><input type="number" class="calc-points" value="@Model.Atributos[4].Pontos" oninput="updateBonus(this)"></div>
                                    <div class="attr-foot"><div class="attr-foot-bubble"><span>Bônus</span><input type="text" class="calc-bonus" id="bonus-CONH" readonly tabindex="-1"></div></div>
                                </div>
                                <div class="attr-box-t20">
                                    <div class="attr-title-wrapper"><div class="attr-title">CAR.</div></div>
                                    <div class="attr-points"><input type="number" class="calc-points" value="@Model.Atributos[5].Pontos" oninput="updateBonus(this)"></div>
                                    <div class="attr-foot"><div class="attr-foot-bubble"><span>Bônus</span><input type="text" class="calc-bonus" id="bonus-CAR" readonly tabindex="-1"></div></div>
                                </div>
                                <div class="attr-box-t20">
                                    <div class="attr-title-wrapper"><div class="attr-title">PREC.<br>CURTA</div></div>
                                    <div class="attr-points"><input type="number" class="calc-points" value="@Model.Atributos[6].Pontos" oninput="updateBonus(this)"></div>
                                    <div class="attr-foot"><div class="attr-foot-bubble"><span>Bônus</span><input type="text" class="calc-bonus" id="bonus-PRE_C" readonly tabindex="-1"></div></div>
                                </div>
                                <div class="attr-box-t20">
                                    <div class="attr-title-wrapper"><div class="attr-title">PREC.<br>LONGA</div></div>
                                    <div class="attr-points"><input type="number" class="calc-points" value="@Model.Atributos[7].Pontos" oninput="updateBonus(this)"></div>
                                    <div class="attr-foot"><div class="attr-foot-bubble"><span>Bônus</span><input type="text" class="calc-bonus" id="bonus-PRE_L" readonly tabindex="-1"></div></div>
                                </div>
                                <div class="attr-box-t20">
                                    <div class="attr-title-wrapper"><div class="attr-title">PROF.</div></div>
                                    <div class="attr-points"><input type="number" class="calc-points" value="@Model.Atributos[8].Pontos" oninput="updateBonus(this)"></div>
                                    <div class="attr-foot"><div class="attr-foot-bubble"><span>Bônus</span><input type="text" class="calc-bonus" id="bonus-PROF" readonly tabindex="-1"></div></div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- T20 VITALS PANEL -->
                    <div class="cyber-panel-wrapper" style="height: fit-content">
                        <div class="panel-title">Recursos Vitais</div>
                        <div class="cyber-panel-bg"><div class="inner-line"></div></div>
                        <div class="cyber-panel-content">
                            <div class="vitals-t20-grid">
                                <div class="vital-t20-box">
                                    <div class="vital-max"><input type="text" value="@Model.Recursos[0].Maximo" placeholder="20"><span>Máximos</span></div>
                                    <div class="vital-current">
                                        <span class="vital-title">Pontos de Vida</span>
                                        <input type="text" value="@Model.Recursos[0].Atual" placeholder="20">
                                        <span class="vital-sub">Atuais</span>
                                    </div>
                                </div>
                                <div class="vital-t20-box">
                                    <div class="vital-max"><input type="text" value="@Model.Recursos[1].Maximo" placeholder="24"><span>Máximos</span></div>
                                    <div class="vital-current">
                                        <span class="vital-title">PRP</span>
                                        <input type="text" value="@Model.Recursos[1].Atual" placeholder="24">
                                        <span class="vital-sub">Atuais</span>
                                    </div>
                                </div>
                                <div class="vital-t20-box">
                                    <div class="vital-max"><input type="text" value="@Model.Recursos[2].Maximo" placeholder="12"><span>Máximos</span></div>
                                    <div class="vital-current">
                                        <span class="vital-title">Pontos Psiônicos</span>
                                        <input type="text" value="@Model.Recursos[2].Atual" placeholder="12">
                                        <span class="vital-sub">Atuais</span>
                                    </div>
                                </div>
                                <div class="vital-t20-box">
                                    <div class="vital-max"><input type="text" value="@Model.Recursos[3].Maximo" placeholder="100"><span>Máximos</span></div>
                                    <div class="vital-current">
                                        <span class="vital-title" style="color: #ff3366;">Sanidade</span>
                                        <input type="text" value="@Model.Recursos[3].Atual" placeholder="100">
                                        <span class="vital-sub">Atuais</span>
                                    </div>
                                </div>
                                <div class="vital-t20-box">
                                    <div class="vital-max"><input type="text" value="@Model.Recursos[4].Maximo" placeholder="9"><span>Base</span></div>
                                    <div class="vital-current">
                                        <span class="vital-title" style="color: #ffaa00;">Deslocamento</span>
                                        <input type="text" value="@Model.Recursos[4].Atual" placeholder="9m">
                                        <span class="vital-sub">Atual</span>
                                    </div>
                                </div>
                                <div class="vital-t20-box">
                                    <div class="vital-max"><input type="text" value="@Model.Recursos[5].Maximo" placeholder="10"><span>Base</span></div>
                                    <div class="vital-current">
                                        <span class="vital-title" style="color: #00ffaa;">Barreira</span>
                                        <input type="text" value="@Model.Recursos[5].Atual" placeholder="10">
                                        <span class="vital-sub">Total</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- SUBGRID DE COMBATE (Armas e Ações / Ataques e CA) -->
                    <div class="sub-grid-2" style="flex-grow: 1;">
                        <!-- Sub-Esquerda: Armas e Ataques -->
                        <div class="col-flex">
                            <div class="cyber-panel-wrapper">
                                <div class="panel-title">Armas e Armaduras</div>
                                <div class="cyber-panel-bg"><div class="inner-line"></div></div>
                                <div class="cyber-panel-content">
                                    <div style="display: flex; flex-direction: column; gap: 10px; padding-top: 10px;">
                                        <div style="display: flex; align-items: baseline; gap: 10px; border-bottom: 1px solid var(--neon-blue-dim); padding-bottom: 5px;">
                                            <span class="label" style="color: var(--text-label); font-weight: 600; width: 120px;">Armadura:</span>
                                            <input type="text" id="in-armadura" value="@Model.Armadura" class="input-line" placeholder="...">
                                        </div>
                                        <div style="display: flex; align-items: baseline; gap: 10px; border-bottom: 1px solid var(--neon-blue-dim); padding-bottom: 5px;">
                                            <span class="label" style="color: var(--text-label); font-weight: 600; width: 120px;">Arma:</span>
                                            <input type="text" id="in-arma" value="@Model.Arma" class="input-line" placeholder="...">
                                        </div>
                                        <div style="display: flex; align-items: baseline; gap: 10px; border-bottom: 1px solid var(--neon-blue-dim); padding-bottom: 5px;">
                                            <span class="label" style="color: var(--text-label); font-weight: 600; width: 120px;">Defesa da Arma:</span>
                                            <input type="number" value="@Model.Def_arma" id="defesa-arma" class="input-line" placeholder="0" style="text-align: right;" oninput="updateCA()">
                                        </div>
                                        <div style="display: flex; align-items: baseline; gap: 10px; border-bottom: 1px solid var(--neon-blue-dim); padding-bottom: 5px;">
                                            <span class="label" style="color: var(--text-label); font-weight: 600; width: 120px;">Alcance:</span>
                                            <input type="text" id="in-alcance" value="@Model.Alcance" class="input-line" placeholder="0" style="text-align: right;">
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Painel Ataques e Danos alinhado com CA usando mt-auto -->
                            <div class="cyber-panel-wrapper panel-mt-auto">
                                <div class="panel-title">Ataques e Danos</div>
                                <div class="cyber-panel-bg"><div class="inner-line"></div></div>
                                <div class="cyber-panel-content">
                                    <div class="cyber-table">
                                        <div class="cyber-table-header">
                                            <span class="cyber-table-cell label" style="flex: 2; color: var(--text-label);">Categoria</span>
                                            <span class="cyber-table-cell" title="Bônus de Ataque">Bônus Atq.</span>
                                            <span class="cyber-table-cell" title="Bônus de Dano">Bônus Dano</span>
                                        </div>
                                        <div class="cyber-table-row">
                                            <span class="cyber-table-cell label" style="flex: 2;">Base</span>
                                            <span class="cyber-table-cell"><input type="number" value="0" class="input-line" placeholder="0"></span>
                                            <span class="cyber-table-cell"><input type="text" class="input-line" placeholder="+1d6"></span>
                                        </div>
                                        <div class="cyber-table-row">
                                            <span class="cyber-table-cell label" style="flex: 2;">Corte</span>
                                            <span class="cyber-table-cell"><input type="number" value="@Model.Ataques[0].Bonus" class="input-line" placeholder="0"></span>
                                            <span class="cyber-table-cell"><input type="text" value="@Model.Ataques[0].Extra" class="input-line" placeholder="+1d6"></span>
                                        </div>
                                        <div class="cyber-table-row">
                                            <span class="cyber-table-cell label" style="flex: 2;">Perfuração</span>
                                            <span class="cyber-table-cell"><input type="number" value="@Model.Ataques[1].Bonus" class="input-line" placeholder="0"></span>
                                            <span class="cyber-table-cell"><input type="text" value="@Model.Ataques[1].Extra" class="input-line" placeholder="+1d6"></span>
                                        </div>
                                        <div class="cyber-table-row">
                                            <span class="cyber-table-cell label" style="flex: 2;">Efeito</span>
                                            <span class="cyber-table-cell"><input type="number" value="@Model.Ataques[2].Bonus" class="input-line" placeholder="0"></span>
                                            <span class="cyber-table-cell"><input type="text" value="@Model.Ataques[2].Extra" class="input-line" placeholder="+1d6"></span>
                                        </div>
                                        <div class="cyber-table-row">
                                            <span class="cyber-table-cell label" style="flex: 2;">Impacto</span>
                                            <span class="cyber-table-cell"><input type="number" value="@Model.Ataques[3].Bonus" class="input-line" placeholder="0"></span>
                                            <span class="cyber-table-cell"><input type="text" value="@Model.Ataques[3].Extra" class="input-line" placeholder="+1d6"></span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Sub-Direita: Ações e CA -->
                        <div class="col-flex">
                            <div class="cyber-panel-wrapper">
                                <div class="panel-title">Ações Rápidas</div>
                                <div class="cyber-panel-bg"><div class="inner-line"></div></div>
                                <div class="cyber-panel-content">
                                    <div style="display: grid; grid-template-columns: 1fr; gap: 10px; padding-top: 5px;">
                                        <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--neon-blue-dim); padding-bottom: 5px;">
                                            <span class="label" style="color: var(--text-label); font-weight: 600;">Esquivar</span><input type="text" value="@Model.Esquivar" id="in-esquivar" class="input-line" placeholder="1d20 + 0" style="width: 60%; text-align: right;">
                                        </div>
                                        <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--neon-blue-dim); padding-bottom: 5px;">
                                            <span class="label" style="color: var(--text-label); font-weight: 600;">Atacar</span><input type="text" value="@Model.Atacar" id="in-atacar" class="input-line" placeholder="1d20 + Bônus" style="width: 60%; text-align: right;">
                                        </div>
                                        <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--neon-blue-dim); padding-bottom: 5px;">
                                            <span class="label" style="color: var(--text-label); font-weight: 600;">Interromper</span><input type="text" id="in-interromper" value="@Model.Interromper" class="input-line" placeholder="1d20 + 0" style="width: 60%; text-align: right;">
                                        </div>
