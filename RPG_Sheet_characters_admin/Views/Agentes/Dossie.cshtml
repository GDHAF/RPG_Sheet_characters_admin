                                <span class="cyber-table-cell" style="flex: 0.5; color:var(--text-label); font-size:9px;">B<br><input type="radio" asp_for="Sanidades[4].Nivel" name="abalo_5" value="B" class="neon-checkbox"></span>
                                <span class="cyber-table-cell" style="flex: 0.5; color:var(--text-label); font-size:9px;">M<br><input type="radio" asp_for="Sanidades[4].Nivel" name="abalo_5" value="M" class="neon-checkbox"></span>
                                <span class="cyber-table-cell" style="flex: 0.5; color:var(--text-label); font-size:9px;">A<br><input type="radio" asp_for="Sanidades[4].Nivel" name="abalo_5" value="A" class="neon-checkbox"></span>
