            async function deleteRow(btn) {
                const row = btn.closest('.cyber-table-row');
                const idInput = row.querySelector('.val-id');
                const id = idInput ? parseInt(idInput.value) : 0;

                // Se a linha tem ID 0 (algo falhou na criação), só remove visualmente
                if (id === 0) {
                    row.remove();
                    return;
                }

                // Pergunta ao jogador se ele tem certeza antes de deletar do banco
                if (!confirm("Tem certeza que deseja excluir este registro permanentemente?")) {
                    return;
                }

                // Verifica de qual painel veio o clique para direcionar à Rota correta
                const isHabilidade = row.closest('#habilidades-list') !== null;
                const endpoint = isHabilidade
                    ? `/Agentes/DeletarHabilidade/${id}`
                    : `/Agentes/DeletarItem/${id}`;

                btn.disabled = true; // Desabilita o "X" para evitar duplo clique

                try {
                    const response = await fetch(endpoint, {
                        method: 'DELETE'
                    });

                    if (response.ok) {
                        // Se o banco deletou com sucesso, nós sumimos com a linha da tela
                        row.remove();
                    } else {
                        const err = await response.text();
                        alert("Erro ao excluir o registro: " + err);
                        btn.disabled = false;
                    }
                } catch (error) {
                    alert("Falha na comunicação com o servidor.");
                    btn.disabled = false;
                }
            }


            // ==========================================
            // Função de Exclusão de Personagem
            // ==========================================
            async function deletarPersonagem() {

                const idPersonagem = @(Model.Id ?? 0);

                if (idPersonagem === 0) {
                    alert("Não foi possível identificar o personagem.");
                    return;
                }

                const nomePersonagem = document.getElementById('ficha-nome')?.value || "este personagem";

                const confirmacao = confirm(
                    `ATENÇÃO!\n\n` +
                    `Você está prestes a excluir permanentemente o personagem "${nomePersonagem}".\n\n` +
                    `Todos os dados da ficha, atributos, perícias, recursos, ataques, emoções, ` +
                    `itens, sanidade e habilidades serão apagados.\n\n` +
                    `Esta ação não pode ser desfeita.\n\n` +
                    `Deseja realmente continuar?`
                );

                if (!confirmacao) {
                    return;
                }

                try {

                    const response = await fetch(`/Agentes/DeletarAgente/${idPersonagem}`, {
                        method: 'DELETE'
                    });

                    if (response.ok) {

                        alert("Personagem excluído com sucesso.");

                        window.location.href = '@Url.Action("Listagem", "Agentes")';

                    } else {

                        const erro = await response.text();

                        alert(
                            "Não foi possível excluir o personagem.\n\n" +
                            erro
                        );
                    }

                } catch (error) {

                    console.error("Erro ao excluir personagem:", error);

                    alert(
                        "Falha na comunicação com o servidor.\n\n" +
                        "O personagem não foi excluído."
                    );
                }
            }

    </script>
</body>
</html>