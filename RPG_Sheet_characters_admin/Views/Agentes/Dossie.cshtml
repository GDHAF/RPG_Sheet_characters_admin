            async function salvarFicha() {
                let base64 = null;
                let fileName = null;

                // Configurar salvamento da Imagem
                if (typeof imgSave !== 'undefined' && imgSave){
                    const imgInput = document.getElementById('image_input');
                    if(imgInput && imgInput.files.length > 0){
                        const file = imgInput.files[0];
                        fileName = file.name;

                        base64 = await new Promise((resolve, reject) => {
                            const reader = new FileReader();
                            reader.readAsDataURL(file);
                            reader.onload = () => {
                                resolve(reader.result.split(',')[1]);
                            };
                            reader.onerror = error => reject(error);
                        });
                    }
                }else{
                    fileName = "@Model.Image_Name";
                    let rawBase64 = "@Html.Raw(Model.Image_Data != null ? Convert.ToBase64String(Model.Image_Data) : "")";
                    
                    base64 = rawBase64 === "" ? null : rawBase64;
                }

                // 1. Coletar IDs Básicos e Header
                const data = {
                    Id: @(Model.Id ?? 0), // Pega o ID diretamente do Razor
                    Nome: document.getElementById('ficha-nome').value,
                    Cod_Agente: document.getElementById('dossier-codinome').value,
                    Nivel_Fis: parseInt(document.getElementById('nivel-fisico').value) || 0,
                    Nivel_Psi: parseInt(document.getElementById('nivel-psionico').value) || 0,
                    Origem: document.getElementById('ficha-origem').value,
                    Idade: parseInt(document.getElementById('ficha-idade').value) || 0,
                    Classe: document.getElementById('ficha-classe').value,
                    Patente: document.getElementById('ficha-patente').value,
                    Equipe: document.getElementById('dossier-equipe').value,
                    Status: document.getElementById('ficha-status').value,
                    Image_Name:fileName,
                    Image_Data: base64,

                    // Textareas do Dossiê e Proficiências
                    Descricao: document.querySelectorAll('.dossier-textarea')[0].value,
                    Historia: document.querySelectorAll('.dossier-textarea')[1].value,
                    Infracoes: document.querySelectorAll('.dossier-textarea')[2].value,
                    Notes: document.querySelectorAll('.dossier-textarea')[3].value,
                    Proficiencia: document.querySelectorAll('.scrollable-content textarea')[0].value,
                    Oficio: document.querySelectorAll('.scrollable-content textarea')[1].value,

                    // Equipamentos e Combate (Buscando pela estrutura de inputs do painel)
                    Armadura: document.getElementById('in-armadura').value,
                    Arma: document.getElementById('in-arma').value,
                    Def_arma: parseInt(document.getElementById('defesa-arma').value) || 0,
                    Alcance: parseInt(document.getElementById('in-alcance').value) || 0,
                    Esquivar: document.getElementById('in-esquivar').value,
                    Atacar: document.getElementById('in-atacar').value,
                    Interromper: document.getElementById('in-interromper').value,
                    Dano: document.getElementById('in-dano').value,

                    // Inicializando Listas
                    Atributos: [],
                    Pericias: [],
                    Recursos: [],
                    Ataques: [],
                    Emocoes: [],
                    Sanidades: []
                };

                // 2. Coletar Atributos
                const atributosBoxes = document.querySelectorAll('.attr-box-t20');
                const atributosNomes = ["FOR", "CON", "DES", "INT", "CONH", "CAR", "PRE_C", "PRE_L", "PROF"];
                atributosBoxes.forEach((box, index) => {
                    data.Atributos.push({
                        Atributo: atributosNomes[index],
                        Pontos: parseInt(box.querySelector('.calc-points').value) || 0
                    });
                });

                // 3. Coletar Perícias
                document.querySelectorAll('.skill-row').forEach(row => {
                    data.Pericias.push({
                        Pericia: row.querySelector('.cell-name').childNodes[0].nodeValue.trim(),
                        Treinado: row.querySelector('.skill-tr').checked,
                        Outros: parseInt(row.querySelector('.skill-outros').value) || 0
                    });
                });

                // 4. Coletar Recursos Vitais
                const recursosNomes = ["Vida", "PRP", "Pontos Psiônicos", "Sanidade", "Deslocamento", "Barreira"];
                const recursosBoxes = document.querySelectorAll('.vital-t20-box');
                recursosBoxes.forEach((box, index) => {
                    data.Recursos.push({
                        TipoRecurso: recursosNomes[index],
                        Maximo: parseInt(box.querySelector('.vital-max input').value) || 0,
                        Atual: parseInt(box.querySelector('.vital-current input').value) || 0
                    });
                });

                // 5. Coletar Ataques (Base, Corte, Perfuração, Efeito, Impacto)
                const ataquesRows = document.querySelectorAll('.panel-mt-auto .cyber-table')[0].querySelectorAll('.cyber-table-row');
                const ataquesNomes = ["Base", "Corte", "Perfuração", "Efeito", "Impacto"];
                ataquesRows.forEach((row, index) => {
                    const inputs = row.querySelectorAll('input');
                    if(ataquesNomes[index] !== "Base"){
                        data.Ataques.push({
                            Categoria: "Ataque",
                            Tipo: ataquesNomes[index],
                            Bonus: parseInt(inputs[0].value) || 0,
                            Extra: inputs[1]?.value || ''
                        });
                    };
                });
                const caNomes = ["Base", "Corte", "Perfuração", "Efeito", "Impacto"];
                // Coletar Defesa CA
                const caRows = document.querySelectorAll('.panel-mt-auto .cyber-table')[1].querySelectorAll('.cyber-table-row');
                caRows.forEach((row, index) => {
                    const inputs = row.querySelectorAll('input');
                    data.Ataques.push({
                        Categoria: "CA",
                        Tipo: caNomes[index],
                        Bonus: parseInt(inputs[0].value) || 0,
                        Extra: ''
                    });
                });

                // 6. Coletar Emoções
                const emocoesNomes = [
                    { id: 'rank-pos-det', nome: 'Determinação' }, { id: 'rank-pos-ent', nome: 'Entusiasmo' },
                    { id: 'rank-pos-auto', nome: 'Autopreservação' }, { id: 'rank-pos-calm', nome: 'Calma' },
                    { id: 'rank-pos-pac', nome: 'Paciência' }, { id: 'rank-pos-alt', nome: 'Altruísmo' },
                    { id: 'rank-neg-rai', nome: 'Raiva' }, { id: 'rank-neg-ans', nome: 'Ansiedade' },
                    { id: 'rank-neg-ego', nome: 'Egoísmo' }, { id: 'rank-neg-fri', nome: 'Frieza' },
                    { id: 'rank-neg-obs', nome: 'Obsessão' }, { id: 'rank-neg-sac', nome: 'Sacrifício' }
                ];
                emocoesNomes.forEach(emo => {
                    data.Emocoes.push({
                        Emocao: emo.nome,
                        Ranking: document.getElementById(emo.id).value
                    });
                });

                // 7. Coletar Sanidade (Abalos)

                const sanidadeRowsDOM = document.querySelectorAll('.layout-bot-grid .cyber-panel-wrapper:first-child .cyber-table-row');

                for (let i = 0; i < 6; i++) {
                    const row = sanidadeRowsDOM[i];
                    if (row) {
                        const checkedRadio = row.querySelector(`input[type="radio"]:checked`);
                        const textarea = row.querySelector('textarea');

                        data.Sanidades.push({
                            Situacao: textarea ? textarea.value : '',
                            Nivel: checkedRadio ? checkedRadio.value : 'B'
                        });
                    }
                }

                // Disparar a requisição PUT
                try {
                    const response = await fetch('/Agentes/Atualizar', {
                        method: 'PUT',
                        headers: {
                            'Content-Type': 'application/json',
                        },
                        body: JSON.stringify(data)
                    });

                    if (response.ok) {
                        alert('Ficha salva com sucesso!');
                    } else {
                        const errorText = await response.text();
                        alert('Erro ao salvar ficha: ' + errorText);
                    }
                } catch (error) {
                    console.error('Erro:', error);
                    alert('Falha na comunicação com o servidor.');
                }
            }

