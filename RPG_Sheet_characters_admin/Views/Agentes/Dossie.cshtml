    <!-- SCRIPT PARA CÁLCULO E LÓGICA GERAL -->
    <script>

            let isInfoMode = false;
            let editRowRef = null; // Referência global para a linha sendo editada
            let imgSave = false;

            document.getElementById("ficha-origem").value = "@Model.Origem";
            document.getElementById("ficha-classe").value = "@Model.Classe";
            document.getElementById("ficha-patente").value = "@Model.Patente";
            document.getElementById("ficha-status").value = "@Model.Status";

            document.getElementById("rank-pos-det").value = "@Model.Emocoes[0].Ranking";
            document.getElementById("rank-pos-ent").value = "@Model.Emocoes[1].Ranking";
            document.getElementById("rank-pos-auto").value = "@Model.Emocoes[2].Ranking";
            document.getElementById("rank-pos-calm").value = "@Model.Emocoes[3].Ranking";
            document.getElementById("rank-pos-pac").value = "@Model.Emocoes[4].Ranking";
            document.getElementById("rank-pos-alt").value = "@Model.Emocoes[5].Ranking";
            document.getElementById("rank-neg-rai").value = "@Model.Emocoes[6].Ranking";
            document.getElementById("rank-neg-ans").value = "@Model.Emocoes[7].Ranking";
            document.getElementById("rank-neg-ego").value = "@Model.Emocoes[8].Ranking";
            document.getElementById("rank-neg-fri").value = "@Model.Emocoes[9].Ranking";
            document.getElementById("rank-neg-obs").value = "@Model.Emocoes[10].Ranking";
            document.getElementById("rank-neg-sac").value = "@Model.Emocoes[11].Ranking";


            function toggleInfo() {
                isInfoMode = !isInfoMode;
                const sheetElements = document.querySelectorAll('.sheet-only');
                const dossierElements = document.querySelectorAll('.dossier-only');

                if (isInfoMode) {
                    sheetElements.forEach(el => el.style.display = 'none');
                    dossierElements.forEach(el => el.style.display = 'block');
                    syncDossier(); // Atualiza os campos antes de mostrar
                } else {
                    sheetElements.forEach(el => el.style.display = '');
                    dossierElements.forEach(el => el.style.display = 'none');
                }
            }

            // Sincroniza campos básicos da ficha com o dossiê (Leitura apenas)
            function syncDossier() {
                document.getElementById('dossier-nome').value = document.getElementById('ficha-nome').value;
                document.getElementById('dossier-origem').value = document.getElementById('ficha-origem').value;
                document.getElementById('dossier-patente').value = document.getElementById('ficha-patente').value;
                document.getElementById('dossier-idade').value = document.getElementById('ficha-idade').value;
                document.getElementById('dossier-status').value = document.getElementById('ficha-status').value;
            }

            // ==========================================
            // Lógica de Modais (Pop-ups)
            // ==========================================
            function openModal(id) {
                document.getElementById(id).style.display = 'flex';
            }

            function closeModal(id) {
                document.getElementById(id).style.display = 'none';
            }

            // Abertura para edição do Modais
            function openNovoInventario() {
                editRowRef = null;
                document.getElementById('form-inventario').reset();
                document.getElementById('inv-id').value = "0";
                openModal('modal-inventario');
            }
            function editInventario(btn) {
                editRowRef = btn.closest('.cyber-table-row');
                document.getElementById('inv-nome').value = btn.innerText;
                document.getElementById('inv-id').value = editRowRef.querySelector('.val-id').value;
                document.getElementById('inv-qtd').value = editRowRef.querySelector('.val-qtd').value;
                openModal('modal-inventario');
            }
            function openNovoEquipamento() {
                editRowRef = null;
                document.getElementById('form-equipamento').reset();
                document.getElementById('eq-id').value = "0";
                openModal('modal-equipamento');
            }
            function editEquipamento(btn) {
                editRowRef = btn.closest('.cyber-table-row');
                document.getElementById('eq-nome').value = btn.innerText;
                document.getElementById('eq-id').value = editRowRef.querySelector('.val-id').value;
                document.getElementById('eq-qtd').value = editRowRef.querySelector('.val-qtd').value;
                openModal('modal-equipamento');
            }
            function openNovoHabilidade() {
                editRowRef = null;
                document.getElementById('form-habilidade').reset();
                document.getElementById('hab-id').value = "0";
                openModal('modal-habilidade');
            }
            function editHabilidade(btn) {
                editRowRef = btn.closest('.cyber-table-row');
                document.getElementById('hab-nome').value = btn.innerText;
                document.getElementById('hab-id').value = editRowRef.querySelector('.val-id').value;
                document.getElementById('hab-custo').value = editRowRef.querySelector('.val-custo').value;
                document.getElementById('hab-alcance').value = editRowRef.querySelector('.val-alcance').value;
                document.getElementById('hab-efeito').value = editRowRef.querySelector('.val-efeito').value;

                document.getElementById('hab-aprimorado').checked = (editRowRef.querySelector('.val-aprimorado').checked);
                document.getElementById('hab-arma').checked = (editRowRef.querySelector('.val-arma').checked);
                document.getElementById('hab-acao').checked = (editRowRef.querySelector('.val-acao').checked);

                openModal('modal-habilidade');
            }


            // ==========================================
            // Lógica de Atributos e Perícias (T20)
            // ==========================================
            function updateBonus(inputElement) {
                const points = parseInt(inputElement.value) || 0;
                const bonus = Math.floor((points - 10) / 2);

                const attrBox = inputElement.closest('.attr-box-t20');
                const bonusInput = attrBox.querySelector('.calc-bonus');

                if (bonus > 0) {
                    bonusInput.value = '+' + bonus;
                    bonusInput.style.color = 'var(--bonus-pos)';
                    bonusInput.style.textShadow = '0 0 5px rgba(0, 255, 170, 0.5)';
                } else if (bonus < 0) {
                    bonusInput.value = bonus;
                    bonusInput.style.color = 'var(--bonus-neg)';
                    bonusInput.style.textShadow = '0 0 5px rgba(255, 51, 102, 0.5)';
                } else {
                    bonusInput.value = '0';
                    bonusInput.style.color = '#ffffff';
                    bonusInput.style.textShadow = 'none';
                }

                updateSkills();
            }

            function updateSkills() {
                const nFis = parseInt(document.getElementById('nivel-fisico').value) || 0;
                const nPsi = parseInt(document.getElementById('nivel-psionico').value) || 0;
                const halfFis = Math.floor(nFis / 2);
                const halfPsi = Math.floor(nPsi / 2);

                const getBonus = (id) => parseInt(document.getElementById(id).value) || 0;

                const attrBonuses = {
                    'FOR': getBonus('bonus-FOR'), 'CON': getBonus('bonus-CON'),
                    'DES': getBonus('bonus-DES'), 'INT': getBonus('bonus-INT'),
                    'CONH': getBonus('bonus-CONH'), 'CAR': getBonus('bonus-CAR'),
                    'PRE_C': getBonus('bonus-PRE_C'), 'PRE_L': getBonus('bonus-PRE_L'),
                    'PROF': getBonus('bonus-PROF')
                };

                const skillRows = document.querySelectorAll('.skill-row');
                skillRows.forEach(row => {
                    const attrKey = row.getAttribute('data-attr');
                    const nvlType = row.getAttribute('data-nvl');

                    const isTrained = row.querySelector('.skill-tr').checked;
                    const outrosVal = parseInt(row.querySelector('.skill-outros').value) || 0;

                    const valAttr = attrBonuses[attrKey] || 0;
                    const valTreino = isTrained ? 2 : 0;
                    const valNvl = (nvlType === 'psi') ? halfPsi : halfFis;

                    const total = valAttr + valTreino + valNvl + outrosVal;

                    row.querySelector('.skill-attr').value = valAttr > 0 ? '+' + valAttr : valAttr;
                    row.querySelector('.skill-treino').value = '+' + valTreino;
                    row.querySelector('.skill-nvl').value = '+' + valNvl;
                    row.querySelector('.skill-total').value = total;
                });

                updateCA();
            }

            function updateCA() {
                const defArma = parseInt(document.getElementById('defesa-arma').value) || 0;
                const lutaTotal = parseInt(document.getElementById('luta-total').value) || 0;
                const baseCA = 2 + defArma + lutaTotal;

                const cats = ['corte', 'perf', 'efeito', 'impacto'];
                cats.forEach(cat => {
                    const bonus = parseInt(document.getElementById('ca-bonus-' + cat).value) || 0;
                    document.getElementById('ca-total-' + cat).value = baseCA + bonus;
                });
            }

            // ==========================================
            // Lógica de Emoções (Rank -> Bonus -> Hexágono)
            // ==========================================
            const rankMap = { 'S': 6, 'A': 5, 'B': 4, 'C': 3, 'D': 2, 'E': 1, 'F': 0 };

            function calculateHexPoints(ranks) {
                // Ordem Ângulos: Top(-90), TR(-30), BR(30), Bot(90), BL(150), TL(210)
                const angles = [-Math.PI / 2, -Math.PI / 6, Math.PI / 6, Math.PI / 2, 5 * Math.PI / 6, 7 * Math.PI / 6];
                const cx = 100, cy = 100;
                const maxRadius = 60;
                const step = maxRadius / 6;

                let points = [];
                for (let i = 0; i < 6; i++) {
                    let r = ranks[i] * step;
                    let x = cx + r * Math.cos(angles[i]);
                    let y = cy + r * Math.sin(angles[i]);
                    points.push(`${x},${y}`);
                }
                return points.join(' ');
            }

            function createHexGrid(svgId, color) {
                const svg = document.getElementById(svgId);
                const angles = [-Math.PI / 2, -Math.PI / 6, Math.PI / 6, Math.PI / 2, 5 * Math.PI / 6, 7 * Math.PI / 6];
                const cx = 100, cy = 100;
                const maxRadius = 60;
                const step = maxRadius / 6;

                for (let j = 1; j <= 6; j++) {
                    let r = j * step;
                    let points = angles.map(a => `${cx + r * Math.cos(a)},${cy + r * Math.sin(a)}`).join(' ');
                    let poly = document.createElementNS('http://www.w3.org/2000/svg', 'polygon');
                    poly.setAttribute('points', points);
                    poly.setAttribute('fill', 'none');
                    poly.setAttribute('stroke', color);
                    poly.setAttribute('stroke-width', j === 5 ? '1' : '0.3');
                    if (j !== 5) poly.setAttribute('stroke-dasharray', '2,2');
                    svg.insertBefore(poly, svg.firstChild);
                }

                angles.forEach(a => {
                    let line = document.createElementNS('http://www.w3.org/2000/svg', 'line');
                    line.setAttribute('x1', cx);
                    line.setAttribute('y1', cy);
                    line.setAttribute('x2', cx + maxRadius * Math.cos(a));
                    line.setAttribute('y2', cy + maxRadius * Math.sin(a));
                    line.setAttribute('stroke', color);
                    line.setAttribute('stroke-width', '0.5');
                    svg.insertBefore(line, svg.firstChild);
                });
            }

            function updateEmocoes() {
                const posEmotions = ['det', 'ent', 'auto', 'calm', 'pac', 'alt'];
                const negEmotions = ['rai', 'ans', 'ego', 'fri', 'obs', 'sac'];

                let posRanks = [];
                posEmotions.forEach(emo => {
                    let rankStr = document.getElementById('rank-pos-' + emo).value;
                    let val = rankMap[rankStr] || 0;
                    document.getElementById('bonus-pos-' + emo).value = '+' + val;
                    posRanks.push(val);
                });

                let negRanks = [];
                negEmotions.forEach(emo => {
                    let rankStr = document.getElementById('rank-neg-' + emo).value;
                    let val = rankMap[rankStr] || 0;
                    document.getElementById('bonus-neg-' + emo).value = '+' + val;
                    negRanks.push(val);
                });

                document.getElementById('poly-pos-fill').setAttribute('points', calculateHexPoints(posRanks));
                document.getElementById('poly-neg-fill').setAttribute('points', calculateHexPoints(negRanks));
            }

