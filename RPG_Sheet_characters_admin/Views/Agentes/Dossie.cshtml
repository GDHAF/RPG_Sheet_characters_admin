                            <div class="cyber-table-row" style="border-bottom: 1px solid var(--neon-blue-dim); padding: 5px 0;">
                                <span class="cyber-table-cell label" style="flex: 4;">
                                    <textarea rows="2" placeholder="Situação 5..." style="min-height: 35px; font-size: 13px; padding:2px; border:none; border-bottom:1px dashed var(--neon-blue-glow); background:transparent;">@Model.Sanidades[4].Situacao</textarea>
