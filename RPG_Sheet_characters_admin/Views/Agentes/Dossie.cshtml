                    let response;
                    if (idItem === 0) {
                        // ADICIONAR (POST)
                        response = await fetch(`/Agentes/AdicionarItem/${idPersonagemAtual}`, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify(payload)
                        });
